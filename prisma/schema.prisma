generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CustomerStatus {
  NEW
  ACTIVE
  VIP
  AT_RISK
  INACTIVE
  UNSUBSCRIBED
}

model Customer {
  id                 String         @id @default(cuid())
  email              String         @unique
  firstName          String?
  lastName           String?
  phone              String?
  country            String?
  language           String?        @db.VarChar(10)
  marketingConsent   Boolean        @default(false)
  marketingConsentAt DateTime?
  unsubscribed       Boolean        @default(false)
  unsubscribedAt     DateTime?
  customerStatus     CustomerStatus @default(NEW)
  firstPurchaseAt    DateTime?
  lastPurchaseAt     DateTime?
  totalOrders        Int            @default(0)
  totalSpent         Decimal        @default(0) @db.Decimal(14, 2)
  averageOrderValue  Decimal        @default(0) @db.Decimal(14, 2)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  orders         Order[]
  checkouts      Checkout[]
  emailMessages  EmailMessage[]
  supportTickets SupportTicket[]
  aiInteractions AiInteraction[]
  events         CustomerEvent[]

  @@index([email])
  @@index([unsubscribed])
  @@index([marketingConsent])
  @@index([customerStatus])
  @@index([lastPurchaseAt])
  @@map("customers")
}

enum CustomerEventType {
  CUSTOMER_CREATED
  EMAIL_CAPTURED
  PRODUCT_VIEWED
  PRODUCT_ADDED_TO_CART
  CHECKOUT_STARTED
  CHECKOUT_ABANDONED
  ORDER_CREATED
  ORDER_PAID
  ORDER_CANCELLED
  EMAIL_SENT
  EMAIL_OPENED
  EMAIL_CLICKED
  EMAIL_BOUNCED
  SUPPORT_MESSAGE
  SUPPORT_REPLY
  UNSUBSCRIBED
}

model CustomerEvent {
  id         String            @id @default(cuid())
  customerId String
  type       CustomerEventType
  metadata   Json              @default("{}")
  createdAt  DateTime          @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([type])
  @@index([createdAt])
  @@index([customerId, createdAt])
  @@map("customer_events")
}

model Order {
  id              String   @id @default(cuid())
  customerId      String
  externalOrderId String   @unique
  totalAmount     Decimal  @db.Decimal(12, 2)
  currency        String   @db.VarChar(3)
  status          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

enum CheckoutStatus {
  ACTIVE
  ABANDONED
  RECOVERED
  EXPIRED
}

model Checkout {
  id                 String         @id @default(cuid())
  customerId         String
  email              String
  externalCheckoutId String         @unique
  cartData           Json
  totalAmount        Decimal        @db.Decimal(12, 2)
  currency           String         @db.VarChar(3)
  status             CheckoutStatus @default(ACTIVE)
  abandonedAt        DateTime?
  recoveredAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  emailMessages EmailMessage[]

  @@index([customerId])
  @@index([status])
  @@index([abandonedAt])
  @@index([email])
  @@map("checkouts")
}

enum EmailCampaignType {
  ABANDONED_CHECKOUT
  WELCOME
  POST_PURCHASE
  REVIEW_REQUEST
  WIN_BACK
  PRODUCT_FOLLOWUP
  SUPPORT
  CUSTOM
}

enum EmailCampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

model EmailCampaign {
  id            String              @id @default(cuid())
  name          String
  type          EmailCampaignType
  status        EmailCampaignStatus @default(DRAFT)
  targetSegment String?
  description   String?             @db.Text
  experimentId  String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  emailMessages EmailMessage[]

  @@index([status])
  @@index([type])
  @@index([targetSegment])
  @@map("email_campaigns")
}

enum EmailDirection {
  OUTBOUND
  INBOUND
}

enum EmailType {
  ABANDONED_CHECKOUT
  FOLLOW_UP
  SUPPORT
  ORDER_UPDATE
  OTHER
}

enum EmailStatus {
  QUEUED
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  FAILED
}

model EmailMessage {
  id                String         @id @default(cuid())
  customerId        String
  campaignId        String?
  checkoutId        String?
  direction         EmailDirection
  type              EmailType
  recipientEmail    String
  senderEmail       String
  subject           String
  body              String         @db.Text
  providerMessageId String?
  status            EmailStatus    @default(QUEUED)
  sentAt            DateTime?
  deliveredAt       DateTime?
  openedAt          DateTime?
  clickedAt         DateTime?
  bouncedAt         DateTime?
  aiGenerated       Boolean        @default(false)
  aiModel           String?
  aiConfidence      Float?
  generationReason  String?        @db.Text
  variant           String?
  experimentId      String?
  createdAt         DateTime       @default(now())

  customer Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  campaign EmailCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  checkout Checkout?      @relation(fields: [checkoutId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([campaignId])
  @@index([checkoutId])
  @@index([recipientEmail])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([experimentId])
  @@index([customerId, type, subject, createdAt])
  @@map("email_messages")
}

enum SupportTicketStatus {
  OPEN
  AI_HANDLED
  HUMAN_REQUIRED
  CLOSED
}

enum SupportCategory {
  ORDER_STATUS
  SHIPPING
  PRODUCT_QUESTION
  PRODUCT_USAGE
  RETURN
  REFUND
  PAYMENT
  COMPLAINT
  GENERAL_QUESTION
  OTHER
}

model SupportTicket {
  id              String              @id @default(cuid())
  customerId      String
  email           String
  subject         String
  originalMessage String              @db.Text
  category        SupportCategory     @default(OTHER)
  aiResponse      String?             @db.Text
  aiConfidence    Float?
  status          SupportTicketStatus @default(OPEN)
  humanRequired   Boolean             @default(false)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@index([email])
  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@map("support_tickets")
}

model Unsubscribe {
  id        String   @id @default(cuid())
  email     String   @unique
  reason    String?
  createdAt DateTime @default(now())

  @@index([email])
  @@map("unsubscribes")
}

enum SuppressionReason {
  BOUNCE
  COMPLAINT
  MANUAL
  INVALID
}

model EmailSuppression {
  id        String            @id @default(cuid())
  email     String            @unique
  reason    SuppressionReason
  createdAt DateTime          @default(now())

  @@index([email])
  @@map("email_suppressions")
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model AiInteraction {
  id         String   @id @default(cuid())
  customerId String?
  type       String
  input      Json
  output     Json
  model      String?
  createdAt  DateTime @default(now())

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([type])
  @@index([createdAt])
  @@map("ai_interactions")
}
