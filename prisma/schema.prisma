generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id                 String    @id @default(cuid())
  email              String    @unique
  firstName          String?
  lastName           String?
  phone              String?
  country            String?
  marketingConsent   Boolean   @default(false)
  marketingConsentAt DateTime?
  unsubscribed       Boolean   @default(false)
  unsubscribedAt     DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  orders          Order[]
  checkouts       Checkout[]
  emailMessages   EmailMessage[]
  supportTickets  SupportTicket[]
  aiInteractions  AiInteraction[]

  @@index([email])
  @@index([unsubscribed])
  @@index([marketingConsent])
  @@map("customers")
}

model Order {
  id              String   @id @default(cuid())
  customerId      String
  externalOrderId String   @unique
  totalAmount     Decimal  @db.Decimal(12, 2)
  currency        String   @db.VarChar(3)
  status          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

enum CheckoutStatus {
  ACTIVE
  ABANDONED
  RECOVERED
  EXPIRED
}

model Checkout {
  id                  String         @id @default(cuid())
  customerId          String
  email               String
  externalCheckoutId  String         @unique
  cartData            Json
  totalAmount         Decimal        @db.Decimal(12, 2)
  currency            String         @db.VarChar(3)
  status              CheckoutStatus @default(ACTIVE)
  abandonedAt         DateTime?
  recoveredAt         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  emailMessages EmailMessage[]

  @@index([customerId])
  @@index([status])
  @@index([abandonedAt])
  @@index([email])
  @@map("checkouts")
}

enum EmailDirection {
  OUTBOUND
  INBOUND
}

enum EmailType {
  ABANDONED_CHECKOUT
  FOLLOW_UP
  SUPPORT
  ORDER_UPDATE
  OTHER
}

enum EmailStatus {
  QUEUED
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  FAILED
}

model EmailMessage {
  id                String         @id @default(cuid())
  customerId        String
  checkoutId        String?
  direction         EmailDirection
  type              EmailType
  recipientEmail    String
  senderEmail       String
  subject           String
  body              String         @db.Text
  providerMessageId String?
  status            EmailStatus    @default(QUEUED)
  sentAt            DateTime?
  deliveredAt       DateTime?
  openedAt          DateTime?
  clickedAt         DateTime?
  bouncedAt         DateTime?
  createdAt         DateTime       @default(now())

  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  checkout Checkout? @relation(fields: [checkoutId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([checkoutId])
  @@index([recipientEmail])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([customerId, type, subject, createdAt])
  @@map("email_messages")
}

enum SupportTicketStatus {
  OPEN
  AI_HANDLED
  HUMAN_REQUIRED
  CLOSED
}

model SupportTicket {
  id              String              @id @default(cuid())
  customerId      String
  email           String
  subject         String
  originalMessage String              @db.Text
  aiResponse      String?             @db.Text
  aiConfidence    Float?
  status          SupportTicketStatus @default(OPEN)
  humanRequired   Boolean             @default(false)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@map("support_tickets")
}

model Unsubscribe {
  id        String   @id @default(cuid())
  email     String   @unique
  reason    String?
  createdAt DateTime @default(now())

  @@index([email])
  @@map("unsubscribes")
}

model AiInteraction {
  id         String   @id @default(cuid())
  customerId String?
  type       String
  input      Json
  output     Json
  model      String?
  createdAt  DateTime @default(now())

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([type])
  @@index([createdAt])
  @@map("ai_interactions")
}
