NODE_ENV=production
PORT=3000

# PostgreSQL — set in EasyPanel only (never commit real credentials)
DATABASE_URL=

# Store-facing API (ecommerce app / webhooks)
STORE_API_KEY=

# Grok agent API (no database access)
GROK_AGENT_API_KEY=

# Email provider: console (log only) | sendgrid (production)
EMAIL_PROVIDER=
EMAIL_API_KEY=

# Sender / reply-to (change here when you move to support@yourdomain.com)
EMAIL_FROM=beautyvelora038@gmail.com
EMAIL_REPLY_TO=beautyvelora038@gmail.com

# Optional tuning
AGENT_EMAIL_RATE_LIMIT_WINDOW_MS=60000
AGENT_EMAIL_RATE_LIMIT_MAX=30
DUPLICATE_EMAIL_WINDOW_MINUTES=60
ABANDONED_CHECKOUT_MIN_AGE_MINUTES=60
ABANDONED_CHECKOUT_COOLDOWN_HOURS=24
