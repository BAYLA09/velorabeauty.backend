NODE_ENV=production
PORT=3000

DATABASE_URL=

STORE_API_KEY=

GROK_AGENT_API_KEY=

# console (default, logs only) | sendgrid | smtp
EMAIL_PROVIDER=console

# SendGrid only. Also accepts legacy SENDGRID_API_KEY if EMAIL_API_KEY is unset.
EMAIL_API_KEY=

# SMTP only (EMAIL_PROVIDER=smtp). Never commit a real password.
# Gmail / Google Workspace: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_SECURE=false
# SMTP_USER is the mailbox. SMTP_PASSWORD is an app password, not the account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=

EMAIL_FROM=

EMAIL_REPLY_TO=

EMAIL_UNSUBSCRIBE_URL=

MAX_MARKETING_EMAILS_PER_7_DAYS=3

ABANDONED_CHECKOUT_DELAY_MINUTES=30

# Quiet time before an ACTIVE checkout is marked ABANDONED. Separate from the email delay below.
CHECKOUT_ABANDON_AFTER_MINUTES=30

# Google Sheets — COD order rows (optional)
GOOGLE_SHEETS_SPREADSHEET_ID=
# Tab gid from sheet URL (?gid=469291840) — preferred over tab name
GOOGLE_SHEETS_GID=469291840
GOOGLE_SHEETS_TAB_NAME=
# Paste full service account JSON on one line OR use BASE64 for EasyPanel
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

WINBACK_DAYS=60

# Optional tuning
ABANDONED_CHECKOUT_MESSAGE2_HOURS=24
ABANDONED_CHECKOUT_MESSAGE3_HOURS=48
VIP_MIN_TOTAL_SPENT=500
VIP_MIN_ORDERS=5
INACTIVE_DAYS=90
AGENT_EMAIL_RATE_LIMIT_WINDOW_MS=60000
AGENT_EMAIL_RATE_LIMIT_MAX=30
DUPLICATE_EMAIL_WINDOW_MINUTES=60
ABANDONED_CHECKOUT_MIN_AGE_MINUTES=30
