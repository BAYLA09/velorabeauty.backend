NODE_ENV=production
PORT=3000

# PostgreSQL (configure in EasyPanel — never commit real credentials)
DATABASE_URL=postgresql://USER:PASSWORD@postgres:5432/velorabeauty?schema=public

# Store-facing API (ecommerce app / webhooks)
STORE_API_KEY=change-me-store-api-key-min-16-chars

# Grok agent API (no database access — API key only)
GROK_AGENT_API_KEY=change-me-grok-agent-key-min-16-chars

FROM_EMAIL=support@example.com
EMAIL_PROVIDER=console
# SENDGRID_API_KEY=

AGENT_EMAIL_RATE_LIMIT_WINDOW_MS=60000
AGENT_EMAIL_RATE_LIMIT_MAX=30
DUPLICATE_EMAIL_WINDOW_MINUTES=60
ABANDONED_CHECKOUT_MIN_AGE_MINUTES=60
ABANDONED_CHECKOUT_COOLDOWN_HOURS=24
